{
  "gitlab_url": "https://gitlab.example.com",
  "gitlab_token": "glpat-your-api-scope-token",

  "slack": {
    "bot_token": "",
    "app_token": "",
    "channel_id": "",
    "webhook_url": "",
    "mention_user_ids": [],
    "admin_user_ids": [],
    "display_name": "",
    "icon_emoji": ""
  },

  "watch": {
    "group_ids": [],
    "path_prefixes": []
  },

  "review": {
    "project_map": {
      "your-group/your-repo": "/absolute/path/to/local/clone"
    },
    "language": "en",
    "engine": "claude",
    "max_changed_files": 60,
    "max_diff_lines": 3000,
    "review_timeout_seconds": 900,
    "claude": {
      "model": "opus",
      "skeptic_model": "sonnet",
      "effort": "medium"
    },
    "codex": {
      "model": "",
      "skeptic_model": ""
    },
    "release_guard": {
      "test_hosts": ["uat.example.com", "staging.example.com", "10.0.2."],
      "environment_notes": "Production is www.example.com. UAT is uat.example.com, selected by the DEBUG setting in settings/local_settings.py.",
      "max_diff_lines": 3000,
      "max_batches": 15
    }
  }
}
